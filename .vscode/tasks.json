{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "后端 + 数据库（左）",
      "type": "shell",
      "command": "bash .vscode/scripts/backend.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev-split",
        "panel": "shared",
        "reveal": "always",
        "focus": false,
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "前端（右）",
      "type": "shell",
      "command": "bash .vscode/scripts/frontend.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev-split",
        "panel": "shared",
        "reveal": "always",
        "focus": false,
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "🚀 启动前后端（左右分屏）",
      "dependsOn": ["后端 + 数据库（左）", "前端（右）"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

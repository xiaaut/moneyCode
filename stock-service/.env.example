# ============================================================
# stock-service 环境变量模板
# 使用方式：cp .env.example .env  然后填入真实的 NAS 数据库密码
# .env 已被 .gitignore 忽略，切勿提交到仓库
# ============================================================

# ---------- NAS PostgreSQL ----------
# NAS 在局域网中的 IP（把 x.x 换成真实网段，例如 192.168.1.20）
POSTGRES_HOST=192.168.x.x
# NAS Docker 对外映射端口（容器内 5432 -> 宿主机 5434）
POSTGRES_PORT=5434
POSTGRES_USER=postgres
# 必填：NAS 上 PostgreSQL 的密码
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=portfolio_db

# ---------- 连接池（可选，保持默认即可）----------
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600
# DB_CONNECT_TIMEOUT=5
# 打印 SQL 语句，调试时设为 true
# DB_ECHO=false

# ---------- 应用（可选）----------
# APP_NAME=stock-service
# APP_VERSION=0.1.0
# DEBUG=false

# ---------- CORS ----------
# 多个来源用英文逗号分隔，例如：http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=http://localhost:5173

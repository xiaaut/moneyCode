# ============================================================
# stock-service 环境变量模板
# 使用方式：cp .env.example .env  然后填入真实密码与 NAS 地址
# 架构：Mac 本地 PostgreSQL = 主库（Primary）｜飞牛 NAS = 冷备（Backup）
# .env 已被 .gitignore 忽略，切勿提交到仓库
# ============================================================

# ---------- 主库：Mac 本地 PostgreSQL（日常运行，NAS 关机也不受影响）----------
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@127.0.0.1:5432/portfolio_db

# ---------- 冷备：飞牛 NAS PostgreSQL（按需开机，仅同步备份时连接）----------
# 把 192.168.x.x 换成 NAS 真实局域网 IP；5434 为 NAS Docker 映射端口
NAS_DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@192.168.x.x:5434/portfolio_db
# NAS 探活超时（秒）
NAS_DB_CONNECT_TIMEOUT=3

# ---------- 兼容字段（DATABASE_URL 已配置时自动被解析覆盖，仅兜底用）----------
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_DB=portfolio_db

# ---------- 连接池（可选，保持默认即可）----------
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600
# DB_CONNECT_TIMEOUT=5
# 打印 SQL 语句，调试时设为 true
# DB_ECHO=false

# ---------- 应用（可选）----------
# APP_NAME=stock-service
# APP_VERSION=0.1.0
# DEBUG=false

# ---------- CORS ----------
# 多个来源用英文逗号分隔，例如：http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=http://localhost:5173

# ---------- 数据源（同花顺主通道 + 免费备用通道）----------
# 同花顺金融数据 API Key（留空则自动走免费通道）
THS_API_KEY=
# 同花顺 API 地址
THS_BASE_URL=https://fuyao.aicubes.cn
# 数据源模式：ths_first（默认，同花顺优先，异常自动降级） / free_only（强制免费通道）
DATA_SOURCE_MODE=ths_first
